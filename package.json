{
  "name": "never-stop-blowing-up",
  "version": "1.0.0",
  "description": "A custom tabletop RPG system for Foundry VTT featuring explosive action and collaborative storytelling",
  "main": "scripts/nsbu.js",
  "scripts": {
    "build-icons": "node assets/icons/generate-icons.js",
    "build-compendiums": "node scripts/build-compendiums.js",
    "copy-icons": "xcopy \"assets\\icons\\abilities\\*.svg\" \"assets\\abilities\\\" /Y && xcopy \"assets\\icons\\group-abilities\\*.svg\" \"assets\\group-abilities\\\" /Y && xcopy \"assets\\icons\\individual-group-abilities\\*.svg\" \"assets\\individual-group-abilities\\\" /Y",
    "build": "npm run build-icons && npm run copy-icons && npm run build-compendiums",
    "rebuild": "npm run build"
  },
  "keywords": ["foundry", "vtt", "rpg", "tabletop", "ttrpg"],
  "author": "Blake Keller",
  "license": "MIT",
  "dependencies": {
    "uuid": "^9.0.0"
  },
  "devDependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/severandynasty/never-stop-blowing-up.git"
  }
}